  <text x="190" y="980" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="#AD1457">• 47" monitor, controlled lighting</text>
  
  <rect x="870" y="910" width="280" height="80" rx="8" fill="#FCE4EC" stroke="#E91E63" stroke-width="2"/>
  <text x="1010" y="930" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="#AD1457">Objective Metrics:</text>
