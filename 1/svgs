  <text x="600" y="1120" text-anchor="middle" font-family="Arial, sans-serif" font-size="13" fill="white">No perceptible quality loss (CMOS ≈ 0)</text>
  
  <!-- Performance comparison -->
  <rect x="50" y="1170" width="500" height="140" rx="8" fill="#E8F5E8" stroke="#4CAF50" stroke-width="2"/>
