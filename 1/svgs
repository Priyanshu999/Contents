  <text x="600" y="365" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="white">JNDS = JNDlum + JNDtex - C × min(JNDlum, JNDtex)</text>
  <text x="600" y="385" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="white">Pixel-based spatial JND model (Yang et al.)</text>
  
  <!-- JND Details -->
  <rect x="100" y="320" width="280" height="80" rx="8" fill="#E3F2FD" stroke="#2196F3" stroke-width="2"/>
