    Deep Pre-Editing for Better JPEG Compression Pipeline
  </text>
  
  <!-- Input Dataset -->
  <rect x="550" y="70" width="300" height="60" rx="10" fill="url(#inputGrad)" stroke="#388E3C" stroke-width="2"/>
  <text x="700" y="95" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="white">INPUT TRAINING DATA</text>
  <text x="700" y="115" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="white">Burst processed images (120K patches, 480×640)</text>
  
  <!-- Dataset Details -->
  <rect x="50" y="70" width="400" height="140" rx="8" fill="#E8F5E8" stroke="#4CAF50" stroke-width="2"/>
  <text x="250" y="95" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#2E7D32">Training Dataset:</text>
  <text x="250" y="115" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#2E7D32">• Hasinoff et al. burst images (3640 images)</text>
  <text x="250" y="135" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#2E7D32">• 12 mega pixels → 8-bit PNG format</text>
