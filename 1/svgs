  <text x="190" y="860" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="#6A1B9A">• Bitrates: 5.5-53 Mbps</text>
  
  <rect x="870" y="790" width="280" height="80" rx="8" fill="#F3E5F5" stroke="#9C27B0" stroke-width="2"/>
  <text x="1010" y="810" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="#6A1B9A">HEVC Settings:</text>
  <text x="1010" y="830" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="#6A1B9A">• Main Profile</text>
  <text x="1010" y="845" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="#6A1B9A">• CTU up to 64×64</text>
  <text x="1010" y="860" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="#6A1B9A">• Loop filters enabled</text>
  
  <!-- Arrow -->
  <line x1="600" y1="870" x2="600" y2="900" stroke="#333" stroke-width="3" marker-end="url(#arrowhead)"/>
  
