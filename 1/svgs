    <text x="125" y="120" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">y</text>
    <text x="125" y="140" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">Natural Image</text>
  </g>
  
