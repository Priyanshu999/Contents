  <text x="600" y="955" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="white">Objective & Subjective Quality Assessment</text>
  <text x="600" y="975" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="white">Bitrate comparison at constant visual quality</text>
  
  <!-- Evaluation Details -->
  <rect x="50" y="910" width="280" height="80" rx="8" fill="#FCE4EC" stroke="#E91E63" stroke-width="2"/>
