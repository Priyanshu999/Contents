    <rect x="50" y="170" width="150" height="100" rx="10" fill="#e74c3c" stroke="#c0392b" stroke-width="2"/>
    <text x="125" y="190" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="white">Datasets</text>
    <text x="125" y="210" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">• Berkeley Segmentation</text>
    <text x="125" y="225" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">• Kodak Dataset</text>
    <text x="125" y="240" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">• Web Images</text>
    <text x="125" y="255" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">24 images for testing</text>
  </g>
  
  <!-- Initialization -->
  <g id="initialization">
    <rect x="250" y="70" width="150" height="80" rx="10" fill="#9b59b6" stroke="#8e44ad" stroke-width="2"/>
    <text x="325" y="95" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="white">Initialization</text>
    <text x="325" y="115" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">T = Identity mapping</text>
    <text x="325" y="130" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">ε̃ = large bit budget</text>
  </g>
  
  <!-- Weight Map Computation -->
  <g id="weight-map">
    <rect x="450" y="70" width="150" height="80" rx="10" fill="#f39c12" stroke="#e67e22" stroke-width="2"/>
    <text x="525" y="90" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="white">Weight Map</text>
    <text x="525" y="105" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">w(ξ,η) = 1 + α·G*E</text>
    <text x="525" y="120" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">Edge detection</text>
    <text x="525" y="135" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">Gaussian filtering</text>
  </g>
  
  <!-- Iterative Process Box -->
  <rect x="220" y="200" width="760" height="380" rx="15" fill="#ecf0f1" stroke="#bdc3c7" stroke-width="3"/>
  <text x="600" y="225" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#2c3e50">
    Iterative Optimization Process
  </text>
  
  <!-- X-Step: Compression -->
  <g id="x-step">
    <rect x="250" y="250" width="200" height="100" rx="10" fill="#27ae60" stroke="#229954" stroke-width="2"/>
    <text x="350" y="275" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="white">X-Step: Compression</text>
    <text x="350" y="295" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="white">x ← Compress(T{y}, ε̃)</text>
    <text x="350" y="310" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">Rate-distortion optimization</text>
    <text x="350" y="325" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">min ||x - T{y}||² s.t. R(x) ≤ ε̃</text>
  </g>
  
  <!-- Supported CODECs -->
  <g id="codecs">
    <rect x="500" y="250" width="200" height="100" rx="10" fill="#16a085" stroke="#138d75" stroke-width="2"/>
    <text x="600" y="270" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="white">Supported CODECs</text>
    <text x="600" y="290" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">• JPEG, JPEG 2000</text>
    <text x="600" y="305" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">• WebP, BPG</text>
    <text x="600" y="320" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">• Deep-net methods</text>
    <text x="600" y="335" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">• Subband/Global Thresholding</text>
  </g>
  
  <!-- T-Step: Optical Flow -->
  <g id="t-step">
    <rect x="250" y="380" width="200" height="100" rx="10" fill="#e67e22" stroke="#d35400" stroke-width="2"/>
    <text x="350" y="405" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="white">T-Step: Optical Flow</text>
    <text x="350" y="425" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="white">T ← OpticalFlow(y, x)</text>
    <text x="350" y="440" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">min ||x - T{y}||² + λψ(T)</text>
    <text x="350" y="455" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">IRLS algorithm</text>
  </g>
  
  <!-- DASSD Criterion -->
  <g id="dassd">
    <rect x="500" y="380" width="200" height="100" rx="10" fill="#8e44ad" stroke="#7d3c98" stroke-width="2"/>
    <text x="600" y="400" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="white">DASSD Criterion</text>
    <text x="600" y="420" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">d_DASSD(x,y) = min_T ||x - T{y}||²</text>
    <text x="600" y="435" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">+ λψ(T)</text>
    <text x="600" y="450" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">Horn-Schunk regularizer</text>
    <text x="600" y="465" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">λ = 65 (fixed parameter)</text>
  </g>
  
  <!-- Bit Rate Control -->
  <g id="bit-rate">
    <rect x="750" y="250" width="200" height="100" rx="10" fill="#c0392b" stroke="#a93226" stroke-width="2"/>
    <text x="850" y="275" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="white">Gradual Bit Rate Control</text>
    <text x="850" y="295" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">Start: ε̃ = large budget</text>
    <text x="850" y="310" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">Gradually decrease ε̃</text>
    <text x="850" y="325" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">Until ε̃ = target ε</text>
  </g>
  
  <!-- Parameter Settings -->
  <g id="parameters">
    <rect x="750" y="380" width="200" height="100" rx="10" fill="#7f8c8d" stroke="#6c7b7b" stroke-width="2"/>
    <text x="850" y="400" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="white">Parameters</text>
    <text x="850" y="420" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">α: JPEG=20, JPEG2000=3</text>
    <text x="850" y="435" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">WebP/BPG=6</text>
    <text x="850" y="450" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">σ = 10 (Gaussian)</text>
    <text x="850" y="465" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">Bicubic interpolation</text>
  </g>
  
  <!-- Output Section -->
  <g id="output">
    <rect x="50" y="620" width="150" height="80" rx="10" fill="#2ecc71" stroke="#27ae60" stroke-width="2"/>
    <text x="125" y="645" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="white">Deformed Input</text>
    <text x="125" y="665" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">T{y}</text>
    <text x="125" y="680" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="white">Optimally deformed</text>
  </g>
  
