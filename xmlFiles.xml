    <uses-permission android:name="com.samsung.android.providers.media.READ" />
    <uses-permission android:name="com.sec.spp.permission.TOKEN_8b2574a4e8e6d29bcb29d15c8559410cb689aada00725d61183d90eec1edae8e394a8932b22b8ecbf0365ee4dbe7f36641875bc8344a76eb25597b65e92fd98e1c1b4c73ca3b8f7622ea5dbee6c606f7d75c08b78ea5f24e8c90444c1ae9061841275f2489311c844fcb83c28c5c9dc4f8cee793e9f55049872b1bb70c4c0678" />

    <uses-feature android:name="com.samsung.feature.device_category_phone_high_end" />
